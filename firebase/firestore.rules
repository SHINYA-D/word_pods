rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 自分の配下データのみ読み書き可。退会済み（deleted_accounts/{uid} がある）なら書き込めない。
    // 他の端末に残っているログイン情報（最大1時間有効）で、同期によって削除したデータが作り直されるのを防ぐため
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && !exists(/databases/$(database)/documents/deleted_accounts/$(userId));
    }

    // 退会済みの記録。ログインしていない端末からも退会済みかを確認できるよう、1件ずつの読み取りだけ許す
    // （uid と退会日時だけで、個人を特定できる情報は持たない）。一覧の読み取りと書き込みはサーバーだけ
    match /deleted_accounts/{userId} {
      allow get: if true;
      allow list, write: if false;
    }

    // 開発者フラグ・サブスク・規約同意。本人は読むだけで、書き込みはサーバー（Admin SDK）だけ
    match /accounts/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if false;
    }

    // 規約への同意の履歴。退会後も残す証跡。読み書きともサーバー（Admin SDK）だけ
    match /consent_logs/{userId}/{document=**} {
      allow read, write: if false;
    }

    // アプリ全体の設定（規約の現行版数など）。誰でも読めて、書き込みはサーバーだけ
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
