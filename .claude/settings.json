{
  "permissions": {
    "allow": [
      "Bash(fvm flutter pub get)",
      "Glob",
      "Grep",
      "Read(//Users/a12345/StudioProjects/word_pods/**)",
      "Edit(//Users/a12345/StudioProjects/word_pods/**)",
      "Write(//Users/a12345/StudioProjects/word_pods/**)",
      "Read(//private/tmp/claude-501/**)",
      "Edit(//private/tmp/claude-501/**)",
      "Write(//private/tmp/claude-501/**)",
      "Read(//tmp/claude-501/**)",
      "Edit(//tmp/claude-501/**)",
      "Write(//tmp/claude-501/**)",
      "Edit(/.claude/skills/test-loop/**)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(android/key.properties)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/configstore/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(cat .env:*)",
      "Bash(printenv)",
      "Bash(env)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)",
      "Bash(firebase:*)",
      "Bash(flutterfire:*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(bq:*)",
      "Bash(aws:*)",
      "Bash(stripe:*)",
      "Bash(npm publish:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "gh *",
      "firebase *",
      "flutterfire *",
      "gcloud *",
      "fvm flutter pub *",
      "fvm dart pub *",
      "bash scripts/test_harness.sh",
      "bash scripts/test_harness.sh *",
      "npm run test:emulator",
      "npm --prefix functions run test:emulator"
    ],
    "filesystem": {
      "allowWrite": [
        "~/fvm",
        "~/.pub-cache",
        "~/.dart-tool",
        "~/.dartServer",
        "~/.flutter",
        "~/.config/flutter",
        "~/.gradle",
        "~/.npm",
        "~/.cache/firebase",
        "~/Desktop"
      ]
    },
    "network": {
      "allowedDomains": [
        "pub.dev",
        "*.pub.dev",
        "storage.googleapis.com",
        "*.googleapis.com",
        "registry.npmjs.org",
        "github.com",
        "*.githubusercontent.com"
      ],
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/block_direct_flutter_test.sh",
            "statusMessage": "テスト実行方法を確認中..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/require_test_loop_skill.sh",
            "statusMessage": "test-loop手順書の読み込みを確認中..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/block_generated_file_edit.sh",
            "statusMessage": "生成ファイルへの変更でないか確認中..."
          },
          {
            "type": "command",
            "command": "python3 scripts/hooks/check_spec_id_stability.py",
            "statusMessage": "仕様IDの振り直しでないか確認中..."
          },
          {
            "type": "command",
            "command": "python3 scripts/hooks/record_test_scope.py",
            "statusMessage": "依頼範囲内のテストか確認中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/require_test_loop_completion.py",
            "statusMessage": "テスト工程が完了しているか確認中..."
          }
        ]
      }
    ]
  }
}
